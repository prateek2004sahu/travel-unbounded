# MongoDB Atlas connection string.
# Get this from MongoDB Atlas -> Connect -> Drivers -> Node.js
# Replace <username>, <password> and <cluster-url> with your own values.
# Make sure the database user's password does NOT contain characters that
# need URL-encoding (or encode them), and that your current IP is
# whitelisted under Network Access (or 0.0.0.0/0 for quick testing).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/travel-unbounded?retryWrites=true&w=majority
